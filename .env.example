# Docker 镜像。默认跟随最新 Release，也可以改为具体版本或 digest。
STREAM_KEEPER_IMAGE=ghcr.io/nianzhibai/streamkeeper:latest

# 会话有效期与单 IP 永久黑名单阈值。
STREAM_KEEPER_SESSION_TTL_HOURS=168
STREAM_KEEPER_LOGIN_MAX_ATTEMPTS=3
STREAM_KEEPER_LOGIN_WINDOW_SECONDS=3600

# 监听地址。默认 0.0.0.0，即所有网络接口都可访问（局域网/公网只要能连到本机端口就能打开）。
# 只想本机访问改成 127.0.0.1。Docker 部署时这一项同时决定宿主机端口的绑定地址。
# 对公网开放时务必设置足够强的密码，并建议配置 HTTPS 反向代理。
STREAM_KEEPER_BIND_ADDRESS=0.0.0.0
STREAM_KEEPER_WEB_PORT=8000

# 录制并发初始值（1-100）；启动后可在 Web「设置」中调整并持久化。
STREAM_KEEPER_MAX_CONCURRENT_RECORDINGS=3
STREAM_KEEPER_FETCH_TIMEOUT_SECONDS=45
TZ=Asia/Shanghai

# 可选。用于首次启动时初始化；也可以登录 Web 页面后配置网盘。
# 项目原生上传到夸克网盘；录像固定归档到根目录 /DouYinStreamKeeper。
STREAM_KEEPER_QUARK_COOKIE=
STREAM_KEEPER_QUARK_ROOT_ID=0

# 可选。项目原生上传到联通云盘；建议同时填写 access token 和 refresh token。
# Family ID 留空表示个人云，填写后表示家庭云。
STREAM_KEEPER_WOPAN_ACCESS_TOKEN=
STREAM_KEEPER_WOPAN_REFRESH_TOKEN=
STREAM_KEEPER_WOPAN_ROOT_ID=0
STREAM_KEEPER_WOPAN_FAMILY_ID=

# 可选。百度网盘官方开放平台凭据；Refresh Token 自动换取 Access Token。
STREAM_KEEPER_BAIDU_ACCESS_TOKEN=
STREAM_KEEPER_BAIDU_REFRESH_TOKEN=
STREAM_KEEPER_BAIDU_CLIENT_ID=
STREAM_KEEPER_BAIDU_CLIENT_SECRET=

# 可选。115 Cookie 可从 115 网页开发者工具复制；也可使用 115 Open 平台 Token。
STREAM_KEEPER_115_COOKIE=
STREAM_KEEPER_115_ACCESS_TOKEN=
STREAM_KEEPER_115_REFRESH_TOKEN=
STREAM_KEEPER_115_ROOT_ID=0

# 可选。光鸭网盘 API 凭据；Device ID 留空时自动生成。
STREAM_KEEPER_GUANGYA_ACCESS_TOKEN=
STREAM_KEEPER_GUANGYA_REFRESH_TOKEN=
STREAM_KEEPER_GUANGYA_CLIENT_ID=
STREAM_KEEPER_GUANGYA_DEVICE_ID=
STREAM_KEEPER_GUANGYA_ROOT_ID=

# 上传模式：scheduled（按 TZ 本地时间定时）或 recording_completed（每场录制完成后）。
STREAM_KEEPER_UPLOAD_MODE=scheduled
STREAM_KEEPER_UPLOAD_HOUR=1
STREAM_KEEPER_UPLOAD_MIN_AGE_MINUTES=5
STREAM_KEEPER_UPLOAD_TIMEOUT_SECONDS=300

# 可选。各直播平台的登录 Cookie。抖音 Cookie 也可以通过
# STREAM_KEEPER_DOUYIN_COOKIE_FILE 指向容器内挂载的只读文件。
# 哔哩哔哩登录 Cookie 可解锁账号有权限观看的高画质；快手触发匿名风控时建议配置 Cookie。
STREAM_KEEPER_DOUYIN_COOKIE=
STREAM_KEEPER_DOUYIN_COOKIE_FILE=
STREAM_KEEPER_BILIBILI_COOKIE=
STREAM_KEEPER_KUAISHOU_COOKIE=

# 三个平台共用此代理。
STREAM_KEEPER_PROXY=
