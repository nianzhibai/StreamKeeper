# 必须修改。Web 登录密码，建议使用 20 位以上随机字符串。
DOUYIN_WEB_USERNAME=admin
DOUYIN_WEB_PASSWORD=replace-with-a-long-random-password

# 会话有效期与单 IP 永久黑名单阈值。
DOUYIN_SESSION_TTL_HOURS=168
DOUYIN_LOGIN_MAX_ATTEMPTS=3
DOUYIN_LOGIN_WINDOW_SECONDS=3600

# 监听地址。默认 0.0.0.0，即所有网络接口都可访问（局域网/公网只要能连到本机端口就能打开）。
# 只想本机访问改成 127.0.0.1。Docker 部署时这一项同时决定宿主机端口的绑定地址。
# 对公网开放时务必设置足够强的密码，并建议配置 HTTPS 反向代理。
DOUYIN_BIND_ADDRESS=0.0.0.0
DOUYIN_WEB_PORT=8000

DOUYIN_MAX_CONCURRENT_RECORDINGS=3
DOUYIN_FETCH_TIMEOUT_SECONDS=45
TZ=Asia/Shanghai

# 可选。用于首次启动时初始化；也可以登录 Web 页面后配置网盘。
# 项目原生上传到夸克网盘；录像固定归档到根目录 /DouYinStreamKeeper。
DOUYIN_QUARK_COOKIE=
DOUYIN_QUARK_ROOT_ID=0

# 可选。项目原生上传到联通云盘；建议同时填写 access token 和 refresh token。
# Family ID 留空表示个人云，填写后表示家庭云。
DOUYIN_WOPAN_ACCESS_TOKEN=
DOUYIN_WOPAN_REFRESH_TOKEN=
DOUYIN_WOPAN_ROOT_ID=0
DOUYIN_WOPAN_FAMILY_ID=

# 可选。百度网盘官方开放平台凭据；Refresh Token 自动换取 Access Token。
DOUYIN_BAIDU_ACCESS_TOKEN=
DOUYIN_BAIDU_REFRESH_TOKEN=
DOUYIN_BAIDU_CLIENT_ID=
DOUYIN_BAIDU_CLIENT_SECRET=

# 可选。115 Cookie 可从 115 网页开发者工具复制；也可使用 115 Open 平台 Token。
DOUYIN_115_COOKIE=
DOUYIN_115_ACCESS_TOKEN=
DOUYIN_115_REFRESH_TOKEN=
DOUYIN_115_ROOT_ID=0

# 可选。光鸭网盘 API 凭据；Device ID 留空时自动生成。
DOUYIN_GUANGYA_ACCESS_TOKEN=
DOUYIN_GUANGYA_REFRESH_TOKEN=
DOUYIN_GUANGYA_CLIENT_ID=
DOUYIN_GUANGYA_DEVICE_ID=
DOUYIN_GUANGYA_ROOT_ID=

# 每日按 TZ 本地时间开始归档；只处理至少 10 分钟未修改的录像。
DOUYIN_UPLOAD_HOUR=1
DOUYIN_UPLOAD_MIN_AGE_MINUTES=10
DOUYIN_UPLOAD_TIMEOUT_SECONDS=300

# 可选。各直播平台的登录 Cookie。抖音 Cookie 也可以通过
# DOUYIN_COOKIE_FILE 指向容器内挂载的只读文件。
# 哔哩哔哩登录 Cookie 可解锁账号有权限观看的高画质；快手触发匿名风控时建议配置 Cookie。
DOUYIN_COOKIE=
DOUYIN_COOKIE_FILE=
BILIBILI_COOKIE=
KUAISHOU_COOKIE=

# 三个平台共用此代理。
DOUYIN_PROXY=
